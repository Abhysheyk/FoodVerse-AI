# Copy to backend/.env and edit. Never commit backend/.env.

APP_ENV=development            # development | test | production
LOG_LEVEL=INFO
ENABLE_API_DOCS=true           # serves /api/docs; set false in production

# PostgreSQL (psycopg v3 driver). Create the role/database first (see README).
DATABASE_URL=postgresql+psycopg://foodverse:CHANGE_ME@localhost:5432/foodverse_dev

# Used to sign short-lived access tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is still the placeholder.
JWT_SECRET_KEY=replace-with-a-long-random-secret-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Cookies. Development over plain http://localhost needs COOKIE_SECURE=false.
# Production (HTTPS) must use COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=strict         # strict | lax | none (none requires COOKIE_SECURE=true)

# Comma-separated exact origins allowed by CORS ('*' is rejected).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional local AI (Ollama). Nothing is downloaded or called unless enabled. ---
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
# Policy flag only. No external AI adapters exist yet; any future one must be opt-in and is
# never used as an automatic fallback.
ALLOW_EXTERNAL_AI_PROVIDERS=false

# --- Tests only: a DEDICATED database whose name contains "test" ---
# TEST_DATABASE_URL=postgresql+psycopg://foodverse:CHANGE_ME@localhost:5432/foodverse_test

# --- Media uploads (Phase 2) ---
# Where uploaded files are stored. Must be OUTSIDE the repository and any web root.
# Default: ~/.foodverse/media (created with owner-only permissions).
# MEDIA_ROOT=/var/lib/foodverse/media
MAX_UPLOAD_BYTES=8388608            # 8 MiB per upload, enforced while streaming
MAX_IMAGE_PIXELS=40000000           # decompression-bomb guard (width x height)
USER_MEDIA_QUOTA_BYTES=524288000    # 500 MiB per user
